--- /dev/null
+++ b/libs/relax/compiler/tests/box_temp_move_out.rs
@@ -0,0 +1,184 @@
+// A value that leaves a temporary Box is owned by whoever took it: the Box frees its memory
+// and does not drop the value again, and what stays behind drops at the statement's end.
+//
+// `Box::from_raw(n).wake()` is futures-util's BiLock::unlock: a second drop of that Waker took
+// one reference too many off a tokio task (a WebSocket's split halves contend on a BiLock), seen
+// as "current: 1, sub: 2" in State::transition_to_terminal or an abort in clone_waker.
+use std::sync::atomic::{AtomicIsize, Ordering::SeqCst};
+use std::sync::Mutex;
+
+static LIVE: AtomicIsize = AtomicIsize::new(0);
+static SERIAL: Mutex<()> = Mutex::new(());
+
+struct D(u64);
+impl D {
+    fn new(v: u64) -> D {
+        LIVE.fetch_add(1, SeqCst);
+        D(v)
+    }
+    fn consume(self) -> u64 {
+        self.0
+    }
+}
+impl Drop for D {
+    fn drop(&mut self) {
+        LIVE.fetch_sub(1, SeqCst);
+    }
+}
+trait Eat {
+    fn eat(self) -> u64;
+}
+impl Eat for D {
+    fn eat(self) -> u64 {
+        self.0
+    }
+}
+struct Pair {
+    a: D,
+    b: D,
+    n: u64,
+}
+impl Pair {
+    fn total(self) -> u64 {
+        self.a.0 + self.b.0 + self.n
+    }
+}
+#[allow(dead_code)]
+struct Outer {
+    inner: Pair,
+    tail: D,
+}
+fn make(v: u64) -> Box<D> {
+    Box::new(D::new(v))
+}
+fn pair(v: u64) -> Box<Pair> {
+    Box::new(Pair { a: D::new(v), b: D::new(v + 1), n: 5 })
+}
+fn outer(v: u64) -> Box<Outer> {
+    Box::new(Outer { inner: Pair { a: D::new(v), b: D::new(v + 1), n: 5 }, tail: D::new(v + 2) })
+}
+fn live() -> isize {
+    LIVE.load(SeqCst)
+}
+fn generic_temp<T: Eat>(f: impl Fn() -> Box<T>) -> u64 {
+    f().eat()
+}
+
+#[test]
+fn a_by_value_method_on_a_temporary_box() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    LIVE.store(0, SeqCst);
+    assert_eq!(Box::new(D::new(1)).consume(), 1);
+    assert_eq!(live(), 0, "Box::new(..).consume()");
+    assert_eq!(make(2).consume(), 2);
+    assert_eq!(live(), 0, "make(..).consume()");
+    let p = Box::into_raw(Box::new(D::new(3)));
+    assert_eq!(unsafe { Box::from_raw(p).consume() }, 3);
+    assert_eq!(live(), 0, "Box::from_raw(p).consume()");
+    let p = Box::into_raw(Box::new(D::new(4)));
+    match p as usize {
+        0 => panic!("null"),
+        1 => {}
+        _ => unsafe {
+            Box::from_raw(p).consume();
+        },
+    }
+    assert_eq!(live(), 0, "Box::from_raw(p).consume() as a match arm's statement");
+    assert_eq!(make(5).eat(), 5);
+    assert_eq!(live(), 0, "a trait method");
+    assert_eq!(generic_temp(|| make(6)), 6);
+    assert_eq!(live(), 0, "in a generic fn");
+    assert_eq!(pair(7).total(), 20);
+    assert_eq!(live(), 0, "a struct of two");
+    let mut opt = Some(make(8));
+    assert_eq!(opt.take().unwrap().consume(), 8);
+    assert_eq!(live(), 0, "opt.take().unwrap().consume()");
+    let nested: Option<Box<Box<D>>> = Some(Box::new(make(9)));
+    assert_eq!(nested.unwrap().consume(), 9);
+    assert_eq!(live(), 0, "through two boxes");
+    let v: Vec<Box<D>> = vec![make(1), make(2), make(3)];
+    assert_eq!(v.into_iter().map(|b| b.eat()).sum::<u64>(), 6);
+    assert_eq!(live(), 0, "a closure's own box is a place");
+}
+
+#[test]
+fn a_box_in_a_place_keeps_working() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    LIVE.store(0, SeqCst);
+    let b = make(1);
+    assert_eq!(b.consume(), 1);
+    assert_eq!(live(), 0, "local.consume()");
+    let b = make(2);
+    let d = *b;
+    assert_eq!(live(), 1);
+    drop(d);
+    assert_eq!(live(), 0, "let d = *local");
+    assert_eq!((*make(3)).consume(), 3);
+    assert_eq!(live(), 0, "(*make(..)).consume()");
+    {
+        let t: Box<(D, D)> = Box::new((D::new(1), D::new(2)));
+        let first = t.0; // the local keeps its other field until its scope ends
+        assert_eq!(live(), 2);
+        drop(first);
+        assert_eq!(live(), 1);
+    }
+    assert_eq!(live(), 0, "the rest of a local box at its scope's end");
+    assert_eq!(pair(3).n, 5); // a Copy field: the whole temporary drops
+    assert_eq!(live(), 0, "a Copy field of a temporary box");
+}
+
+#[test]
+fn a_field_out_of_a_temporary_box() {
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    LIVE.store(0, SeqCst);
+    let a = pair(1).a;
+    assert_eq!(live(), 1, "the rest of the temporary drops at the statement's end");
+    drop(a);
+    assert_eq!(live(), 0);
+    let a = outer(1).inner.a;
+    assert_eq!(live(), 1, "a field of a field");
+    drop(a);
+    assert_eq!(live(), 0);
+    let inner = outer(4).inner;
+    assert_eq!(live(), 2, "a whole inner struct");
+    assert_eq!(inner.total(), 14);
+    assert_eq!(live(), 0);
+    let t = Box::new((D::new(1), D::new(2), 3u8)).1;
+    assert_eq!(live(), 1, "a tuple field");
+    drop(t);
+    assert_eq!(live(), 0);
+}
+
+#[test]
+fn a_waker_woken_out_of_a_temporary_box_is_given_back_once() {
+    use std::task::{RawWaker, RawWakerVTable, Waker};
+    static W: AtomicIsize = AtomicIsize::new(0);
+    unsafe fn c(p: *const ()) -> RawWaker {
+        W.fetch_add(1, SeqCst);
+        RawWaker::new(p, &VT)
+    }
+    unsafe fn wake(_: *const ()) {
+        W.fetch_sub(1, SeqCst);
+    }
+    unsafe fn by_ref(_: *const ()) {}
+    unsafe fn d(_: *const ()) {
+        W.fetch_sub(1, SeqCst);
+    }
+    static VT: RawWakerVTable = RawWakerVTable::new(c, wake, by_ref, d);
+    let _g = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    W.store(1, SeqCst);
+    let w = unsafe { Waker::from_raw(RawWaker::new(std::ptr::null(), &VT)) };
+    // BiLock::unlock: the parked half's waker sits in a Box behind the state's raw pointer
+    let n = Box::into_raw(Box::new(w.clone()));
+    assert_eq!(W.load(SeqCst), 2);
+    match n as usize {
+        0 => panic!("invalid unlocked state"),
+        1 => {}
+        _ => unsafe {
+            Box::from_raw(n).wake();
+        },
+    }
+    assert_eq!(W.load(SeqCst), 1, "woken by value: not dropped after");
+    drop(w);
+    assert_eq!(W.load(SeqCst), 0);
+}
