+    /// A by-value `self` found under the Boxes of a temporary (`make_box().consume()`,
+    /// `Box::from_raw(p).wake()`): the types the boxes hold, outermost first. None when the
+    /// receiver is a place (its moved path frees the boxes), a step is no Box, or the value has
+    /// no drop glue (the temporary's own drop is right then).
+    fn temp_box_self(&mut self, recv: ExprId, rt: TyId, derefs: usize) -> Option<Vec<TyId>> {
+        if derefs == 0 || self.is_place_expr(recv) {
+            return None;
+        }
+        let mut cur = rt;
+        let mut inners = Vec::with_capacity(derefs);
+        for _ in 0..derefs {
+            let inner = self.box_inner(cur)?;
+            inners.push(inner);
+            cur = inner;
+        }
+        if !self.needs_drop_glue(cur) {
+            return None;
+        }
+        Some(inners)
+    }
+
+    /// Takes the temporary Box `x` (see temp_box_self) by value and gives its contents: each
+    /// box's contents are read and its allocation is freed without them, outermost first.
+    fn temp_box_contents(&mut self, x: ExprId, xt: TyId, inners: &[TyId]) -> Val {
+        let b = self.lower_expr(x);
+        let mut leaves = self.to_leaves(b, xt);
+        let mut out = None;
+        for (k, inner) in inners.iter().enumerate() {
+            let v = self.read_place(&Place::Mem(leaves[0], 0), *inner);
+            if let Some(free) = self.u.core_path(&["boxed", "box_free_after_move"]) {
+                let id = self.u.fn_id(FnKey::Inst(free, vec![*inner]));
+                self.nounwind += 1;
+                self.emit(Inst::Call(Callee::Fn(id), leaves.clone(), Vec::new()));
+                self.nounwind -= 1;
+            }
+            if k + 1 < inners.len() {
+                leaves = self.to_leaves(v, *inner);
+            } else {
+                out = Some(v);
+            }
+        }
+        out.expect("a temporary Box has one step at least")
+    }
