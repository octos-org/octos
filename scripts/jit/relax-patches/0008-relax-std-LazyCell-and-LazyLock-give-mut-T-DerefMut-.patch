--- /dev/null
+++ b/libs/relax/compiler/tests/lazy_deref_mut.rs
@@ -0,0 +1,75 @@
+//! `LazyCell` and `LazyLock` give `&mut T` through `DerefMut` and `force_mut`. krilla keeps a
+//! PDF writer in a `LazyCell` and calls `&mut self` methods on it from a second lazy closure;
+//! without the impl that failed with "capture analysis incomplete: unresolved DerefMut obligation".
+
+use std::cell::{Cell, LazyCell};
+use std::sync::LazyLock;
+
+#[test]
+fn lazy_cell_deref_mut_runs_the_init_once_and_gives_the_same_value() {
+    let runs = Cell::new(0);
+    let mut cell = LazyCell::new(|| {
+        runs.set(runs.get() + 1);
+        vec![1]
+    });
+    assert_eq!(runs.get(), 0);
+    cell.push(2);
+    cell.push(3);
+    assert_eq!(runs.get(), 1);
+    assert_eq!(*cell, [1, 2, 3]);
+    assert_eq!(runs.get(), 1);
+}
+
+#[test]
+fn lazy_cell_deref_mut_after_a_shared_deref_sees_the_same_value() {
+    let mut cell = LazyCell::new(|| String::from("a"));
+    assert_eq!(cell.len(), 1);
+    cell.push('b');
+    assert_eq!(&**cell, "ab");
+    LazyCell::force_mut(&mut cell).push('c');
+    assert_eq!(LazyCell::force(&cell), "abc");
+}
+
+// the krilla shape: one lazy closure captures another lazy cell by unique borrow
+#[test]
+fn a_lazy_closure_mutates_through_another_lazy_cell() {
+    let mut sink: Vec<Vec<u8>> = Vec::new();
+    let made = Cell::new(0);
+    {
+        let mut outer = LazyCell::new(|| {
+            made.set(made.get() + 1);
+            &mut sink
+        });
+        let mut inner = LazyCell::new(|| {
+            outer.push(Vec::new());
+            outer.last_mut().unwrap()
+        });
+        assert_eq!(made.get(), 0);
+        for byte in [7u8, 8, 9] {
+            inner.push(byte);
+        }
+        assert_eq!(made.get(), 1);
+    }
+    assert_eq!(sink, [vec![7, 8, 9]]);
+}
+
+#[test]
+fn an_unused_lazy_cell_never_runs_its_init() {
+    let made = Cell::new(0);
+    {
+        let _cell: LazyCell<Vec<u8>, _> = LazyCell::new(|| {
+            made.set(made.get() + 1);
+            Vec::new()
+        });
+    }
+    assert_eq!(made.get(), 0);
+}
+
+#[test]
+fn lazy_lock_deref_mut_and_force_mut() {
+    let mut lock = LazyLock::new(|| vec![1]);
+    lock.push(2);
+    LazyLock::force_mut(&mut lock).push(3);
+    assert_eq!(*lock, [1, 2, 3]);
+    assert_eq!(LazyLock::force(&lock).len(), 3);
+}
