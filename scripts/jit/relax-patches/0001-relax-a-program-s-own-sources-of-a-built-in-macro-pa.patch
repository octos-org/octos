+    /// A program that brings its own sources of a built-in package (octos pins a makepad fork
+    /// for `makepad-script`): that unit and the built-in units above it leave the native sets at
+    /// registration, a built-in unit apart from them stays native, and nothing is reported.
+    #[test]
+    fn a_built_in_package_with_other_sources_runs_on_the_jit_host() {
+        use crate::macro_reg::UnitInfo;
+        let _serial = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+        let root = std::env::temp_dir().join(format!("relax-native-hosted-{}-{}", std::process::id(), std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()));
+        struct Cleanup(std::path::PathBuf);
+        impl Drop for Cleanup { fn drop(&mut self) { let _ = std::fs::remove_dir_all(&self.0); } }
+        let _cleanup = Cleanup(root.clone());
+        let mut reg = Reg::default();
+        for name in ["makepad_micro_proc_macro", "makepad_micro_serde_derive_impl", "makepad_micro_serde_derive", "makepad_alloc_phase"] {
+            for (path, bytes) in packages()[name].files {
+                let path = root.join(name).join(path);
+                std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+                std::fs::write(path, bytes).unwrap();
+            }
+            let unit = reg.units.len();
+            let deps = match unit { 1 => vec![(0, reg.units[0].name.clone())], 2 => vec![(1, reg.units[1].name.clone()), (0, reg.units[0].name.clone())], _ => Vec::new() };
+            reg.units.push(UnitInfo { name: name.into(), src_path: root.join(name).join("src/lib.rs").to_string_lossy().into_owned(), edition: 2021,
+                features: Vec::new(), deps, proc_macro: entries().any(|n| n.krate == name), harness: false, registry: false, cfgs: Vec::new(), env: Vec::new() })
+        }
+        let entry_of = |unit: usize| {
+            let native = entries().find(|n| n.krate == reg.units[unit].name).unwrap();
+            Entry { unit, fname: native.fname.into(), kind: crate::macro_reg::Kind::Derive }
+        };
+        // (alloc_phase is a plain library of the sets: no macro entry, its own unit)
+        let derive = entry_of(2);
+        let mut matching = Graph::new(reg.clone());
+        matching.host_mismatched();
+        assert!(matching.hosted.is_empty() && matching.verdict().is_ok());
+        assert!(matching.find(&derive).unwrap().is_some() && matching.own[3].is_some());
+        // the program's own revision of the helper crate the derive is built on
+        std::fs::write(root.join("makepad_micro_proc_macro/src/macro_lib.rs"), b"// another revision").unwrap();
+        let mut graph = Graph::new(reg.clone());
+        assert!(graph.verdict().unwrap_err().contains("source bytes differ"));
+        assert!(graph.find(&derive).is_err());
+        graph.host_mismatched();
+        assert_eq!(graph.verdict(), Ok(()));
+        let mut hosted: Vec<&str> = graph.hosted.iter().map(|s| s.as_str()).collect();
+        hosted.sort();
+        assert_eq!(hosted, ["makepad_micro_proc_macro", "makepad_micro_serde_derive", "makepad_micro_serde_derive_impl"]);
+        assert!(matches!(graph.find(&derive), Ok(None)), "the derive above the changed helper is the JIT host's");
+        assert!(matches!(graph.own[3], Some(Ok(()))) && graph.verdicts[3].is_ok(), "a built-in unit apart from it stays native");
+        assert!(!graph.watch_paths.iter().any(|p| p.contains("makepad_micro_proc_macro")), "a hosted unit's sources are not the native sets' inputs");
+        assert!(graph.watch_paths.iter().any(|p| p.contains("makepad_alloc_phase")));
+        // and an edit of a hosted unit is no native reload
+        assert!(!graph.reload(&[(root.join("makepad_micro_proc_macro/src/macro_lib.rs").to_str().unwrap(), None)]));
+        assert_eq!(graph.verdict(), Ok(()));
+    }
 }
 
