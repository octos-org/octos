+    /// A program that pins its own version of a built-in package (another makepad revision as a
+    /// git dependency) holds that name with sources the linked macros were not built from. Such a
+    /// unit, and each built-in unit that reaches it, is no native unit of this graph: its macros
+    /// run on the JIT host, as any other proc macro's do. Only at registration: an edit that makes
+    /// a matching package differ while the program runs still reports the mismatch (`reload`).
+    fn host_mismatched(&mut self) {
+        for unit in 0..self.reg.units.len() {
+            if self.own[unit].is_some() && self.verdicts[unit].is_err() {
+                if crate::macro_reg::trace() {
+                    eprintln!("pmhost: {} runs on the JIT host: {}", self.reg.units[unit].name, self.verdicts[unit].as_ref().unwrap_err());
+                }
+                self.hosted.insert(self.reg.units[unit].name.clone());
+                self.own[unit] = None;
+                self.entries[unit].clear();
+            }
+        }
+        if !self.hosted.is_empty() {
+            self.propagate();
+            self.watch_paths = self.input_paths();
+        }
+    }
     fn propagate(&mut self) {
         fn visit(graph: &Graph, unit: usize, visiting: &mut [bool], done: &mut [Option<Result<(), String>>]) -> Result<(), String> {
             if let Some(verdict) = &done[unit] { return verdict.clone(); }
