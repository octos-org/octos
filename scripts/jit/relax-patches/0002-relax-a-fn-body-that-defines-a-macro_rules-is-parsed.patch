diff --git a/libs/relax/compiler/tests/lazy_body_local_macro_rules.rs b/libs/relax/compiler/tests/lazy_body_local_macro_rules.rs
new file mode 100644
index 00000000..635ac0f3
--- /dev/null
+++ b/libs/relax/compiler/tests/lazy_body_local_macro_rules.rs
@@ -0,0 +1,62 @@
+// A fn body that defines a `macro_rules!` it does not call (combine 4.6.7's tuple parsers:
+// `#[allow(unused_macros)] macro_rules! add_errors` in a body the one-element tuple expands
+// without a call). The definition is an item, so the body is parsed at load, not lazily.
+
+macro_rules! make {
+    ($name:ident $(, $call:ident)?) => {
+        fn $name() -> u32 {
+            #[allow(unused_macros)]
+            macro_rules! two {
+                () => {
+                    2
+                };
+            }
+            let x = 1;
+            $( let x = x + $call!(); )?
+            x
+        }
+    };
+}
+
+make!(in_macro_output_unused);
+make!(in_macro_output_used, two);
+
+fn plain_unused() -> u32 {
+    #[allow(unused_macros)]
+    macro_rules! unused {
+        () => {
+            3
+        };
+    }
+    7
+}
+
+#[test]
+fn a_body_with_an_uncalled_local_macro_rules_runs() {
+    assert_eq!(in_macro_output_unused(), 1);
+    assert_eq!(in_macro_output_used(), 3);
+    assert_eq!(plain_unused(), 7);
+}
+
+// `makepad test` itself loads single-file inputs eagerly, so the test above passes there with
+// or without lazy bodies. Run the same functions through the lazy package driver in a fresh
+// loader: before the outline counted `macro_rules!` as an item, that load ended with
+// "a lazily parsed fn body defined an item".
+#[cfg(relax)]
+#[test]
+fn the_lazy_package_driver_keeps_such_a_body_eager() {
+    let dir = std::env::temp_dir().join(format!("relax-lazy-local-macro-rules-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::write(dir.join("Cargo.toml"), "[package]\nname=\"lazy_local_macro_rules\"\nversion=\"0.1.0\"\nedition=\"2021\"\n[[bin]]\nname=\"lazy_local_macro_rules\"\npath=\"main.rs\"\n").unwrap();
+    let source = include_str!("lazy_body_local_macro_rules.rs").to_string()
+        + "\nfn main() { println!(\"{} {} {}\", in_macro_output_unused(), in_macro_output_used(), plain_unused()); }\n";
+    std::fs::write(dir.join("main.rs"), source).unwrap();
+    let loader = std::env::var_os("RELAX_LOADER").expect("Relax names its test loader");
+    let output = std::process::Command::new(loader).args(["run", "--unattended", "lazy_local_macro_rules"]).current_dir(&dir).output().unwrap();
+    std::fs::remove_dir_all(dir).unwrap();
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    assert!(output.status.success(), "{stdout}\n{stderr}");
+    assert_eq!(stdout.trim(), "1 3 7", "{stderr}");
+    assert!(!stderr.contains("lazily parsed fn body"), "{stderr}");
+}
