+//! Std surface that tokio and camino call: `CommandExt::uid`/`gid`, `PathBuf::add_extension`,
+//! `leak` and the capacity methods, `Path::file_prefix` and `with_added_extension`.
+
+use std::ffi::{OsStr, OsString};
+use std::os::unix::process::CommandExt;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+#[test]
+fn file_prefix_splits_at_the_first_dot_after_a_leading_one() {
+    let cases: &[(&str, Option<&str>)] = &[
+        ("foo.tar.gz", Some("foo")),
+        ("foo", Some("foo")),
+        (".foo", Some(".foo")),
+        (".foo.rs", Some(".foo")),
+        ("a/b/.config.d.toml", Some(".config")),
+        ("..", None),
+        ("/", None),
+        ("", None),
+        ("a/..", None),
+        ("x.", Some("x")),
+        ("a/b.c/", Some("b")),
+        ("...", Some(".")),
+    ];
+    for (path, want) in cases {
+        assert_eq!(Path::new(path).file_prefix(), want.map(OsStr::new), "{path:?}");
+    }
+}
+
+#[test]
+fn add_extension_appends_and_keeps_the_old_one() {
+    let cases: &[(&str, &str, bool, &str)] = &[
+        ("a/b.tar", "gz", true, "a/b.tar.gz"),
+        ("a/b", "txt", true, "a/b.txt"),
+        ("a/b/", "txt", true, "a/b.txt"),
+        ("a/b.tar", "", true, "a/b.tar"),
+        ("a/b/", "", true, "a/b/"),
+        ("/", "txt", false, "/"),
+        ("", "txt", false, ""),
+        ("a/..", "txt", false, "a/.."),
+        (".hidden", "bak", true, ".hidden.bak"),
+        ("x.", "y", true, "x..y"),
+    ];
+    for (path, ext, ok, want) in cases {
+        let mut p = PathBuf::from(path);
+        assert_eq!(p.add_extension(ext), *ok, "{path:?} + {ext:?}");
+        assert_eq!(p, PathBuf::from(want), "{path:?} + {ext:?}");
+        assert_eq!(p.as_os_str(), OsStr::new(want), "{path:?} + {ext:?} bytes");
+        assert_eq!(Path::new(path).with_added_extension(ext).as_os_str(), OsStr::new(want), "with_added {path:?}");
+    }
+}
+
+#[test]
+fn add_extension_refuses_a_separator() {
+    let err = std::panic::catch_unwind(|| PathBuf::from("a/b").add_extension("c/d")).unwrap_err();
+    let message = err.downcast_ref::<String>().cloned().unwrap_or_default();
+    assert!(message.contains("extension cannot contain path separators"), "{message:?}");
+}
+
+#[test]
+fn capacity_methods_and_leak() {
+    let mut p = PathBuf::from("abc");
+    p.try_reserve(100).unwrap();
+    assert!(p.capacity() >= 103);
+    p.shrink_to(50);
+    assert!(p.capacity() >= 50 && p.capacity() < 103, "{}", p.capacity());
+    p.shrink_to_fit();
+    assert_eq!(p.capacity(), 3);
+    p.reserve_exact(7);
+    assert!(p.capacity() >= 10);
+    p.try_reserve_exact(20).unwrap();
+    assert!(p.capacity() >= 23);
+    assert!(p.try_reserve(usize::MAX).is_err());
+    assert!(p.try_reserve_exact(usize::MAX).is_err());
+    let leaked: &'static mut Path = p.leak();
+    assert_eq!(leaked, Path::new("abc"));
+
+    let mut s = OsString::from("xy");
+    s.try_reserve(40).unwrap();
+    assert!(s.capacity() >= 42);
+    s.shrink_to(10);
+    assert!(s.capacity() >= 10 && s.capacity() < 42);
+    s.shrink_to_fit();
+    assert_eq!(s.capacity(), 2);
+    s.reserve_exact(5);
+    s.try_reserve_exact(9).unwrap();
+    assert!(s.capacity() >= 11);
+    assert!(s.try_reserve(usize::MAX).is_err());
+    let leaked: &'static mut OsStr = s.leak();
+    leaked.make_ascii_uppercase();
+    assert_eq!(leaked, OsStr::new("XY"));
+}
+
+unsafe extern "C" {
+    fn getuid() -> u32;
+    fn getgid() -> u32;
+}
+
+fn id(flag: &str, cmd: &mut Command) -> String {
+    let out = cmd.arg(flag).output().unwrap();
+    assert!(out.status.success(), "id {flag}: {:?}", out);
+    String::from_utf8(out.stdout).unwrap().trim().to_string()
+}
+
+#[test]
+fn a_child_with_its_own_uid_and_gid_runs_as_them() {
+    let (uid, gid) = unsafe { (getuid(), getgid()) };
+    assert_eq!(id("-u", Command::new("id").uid(uid)), uid.to_string());
+    assert_eq!(id("-g", Command::new("id").gid(gid)), gid.to_string());
+    assert_eq!(id("-u", Command::new("id").uid(uid).gid(gid)), uid.to_string());
+}
+
+#[test]
+fn a_uid_the_process_may_not_take_fails_the_spawn() {
+    if unsafe { getuid() } == 0 {
+        return;
+    }
+    // any other user: setuid is EPERM for a process that is not root
+    let other = unsafe { getuid() } + 1;
+    let err = Command::new("id").uid(other).output().unwrap_err();
+    assert_eq!(err.kind(), std::io::ErrorKind::PermissionDenied, "{err:?}");
+    let err = Command::new("id").gid(unsafe { getgid() } + 12345).output().unwrap_err();
+    assert_eq!(err.kind(), std::io::ErrorKind::PermissionDenied, "{err:?}");
+}
