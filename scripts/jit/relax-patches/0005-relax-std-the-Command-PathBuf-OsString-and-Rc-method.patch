+/// (prefix, rest) split of a file name at its first dot after the first byte (real std's
+/// `split_file_at_dot`): `.tar.gz` has no dot to split at past its leading one.
+fn split_file_at_dot(file: &OsStr) -> (&OsStr, Option<&OsStr>) {
+    let b = file.as_encoded_bytes();
+    if b == b".." || b.is_empty() {
+        return (file, None);
+    }
+    let mut i = 1;
+    while i < b.len() {
+        if b[i] == b'.' {
+            return (OsStr::from_raw_bytes(&b[..i]), Some(OsStr::from_raw_bytes(&b[i + 1..])));
+        }
+        i += 1;
+    }
+    (file, None)
+}
