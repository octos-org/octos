&#x5957;&#x6514;&#x622a;&#x9ad4;&#x7cfb;&#x6b63;&#x88ab;&#x74e6;&#x89e3;&#x3002;</p><p>&#x7b2c;&#x4e00;&#x4ee3;&#x300c;&#x5929;&#x7afa;&#x8475;-1&#x300d;&#x53ef;&#x651c;&#x5e36;&#x9ad8;&#x9054; 20 &#x516c;&#x65a4;&#x5f48;&#x982d;&#xff0c;&#x6700;&#x9ad8;&#x6642;&#x901f;&#x70ba;185&#x516c;&#x91cc;&#x3002;&#x7f8e;&#x570b;&#x667a;&#x5eab;&#x6230;&#x7565;&#x66a8;&#x570b;&#x969b;&#x7814;&#x7a76;&#x4e2d;&#x5fc3;&#xff08;CSIS&#xff09;<a href="https://www.csis.org/analysis/shahed-geran-how-russia-continues-reinvent-one-way-attack-drone?ref=theinitium.com">&#x5831;&#x544a;&#x6307;</a>&#xff0c;&#x4fc4;&#x7f85;&#x65af;&#x81ea;2025&#x5e74;9&#x6708;&#x8d77;&#x63a8;&#x51fa;&#x9996;&#x6b3e;&#x5674;&#x5c04;&#x52d5;&#x529b;&#x6a5f;&#x578b;&#x300c;&#x5929;&#x7afa;&#x8475;-3&#x300d;&#xff0c;&#x914d;&#x5099;&#x4e2d;&#x570b;&#x88fd;&#x6e26;&#x8f2a;&#x5674;&#x5c04;&#x5f15;&#x64ce;&#xff0c;&#x6642;&#x901f;&#x53ef;&#x9054;370&#x516c;&#x91cc;&#x3002;&#x300c;&#x5929;&#x7afa;&#x8475;-4&#x300d;&#x5247;&#x5f37;&#x5316;&#x4e86;&#x6a5f;&#x8eab;&#x7d50;&#x69cb;&#xff0c;&#x300c;&#x5929;&#x7afa;&#x8475;-5&#x300d;&#x5247;&#x64c1;&#x6709;&#x66f4;&#x63a5;&#x8fd1;&#x5de1;&#x5f0b;&#x98db;&#x5f48;&#x7684;&#x65b0;&#x7d50;&#x69cb;&#x3002;&#x5347;&#x7d1a;&#x4e0d;&#x50c5;&#x9650;&#x65bc;&#x901f;&#x5ea6;&#x548c;&#x5916;&#x5f62;&#xff0c;&#x8f03;&#x820a;&#x7684;&#x300c;&#x5929;&#x7afa;&#x8475;&#x300d;&#x50c5;&#x914d;&#x5099;&#x7c21;&#x6613;&#x5c0e;&#x5f15;&#x7cfb;&#x7d71;&#xff0c;&#x800c;&#x8f03;&#x65b0;&#x6b3e;&#x5247;&#x914d;&#x6709;&#x71b1;&#x6210;&#x50cf;&#x651d;&#x5f71;&#x6a5f;&#x3001;AI &#x9a45;&#x52d5;&#x7684;&#x76ee;&#x6a19;&#x9396;&#x5b9a;&#x7cfb;&#x7d71;&#x3001;&#x4fc4;&#x88fd;&#x6297;&#x5e72;&#x64fe;&#x5929;&#x7dda;&#x4ee5;&#x53ca;&#x4e2d;&#x570b;&#x88fd;&#x9020;&#x7684;&#x7db2;&#x72c0;&#x7121;&#x7dda;&#x96fb;&#x7db2;&#x8def;&#x6578;&#x64da;&#x6a5f;&#x3002;</p><p>&#x70cf;&#x514b;&#x862d;&#x8ecd;&#x4e8b;&#x60c5;&#x5831;&#x7e3d;&#x5c40;&#xff08;HUR&#xff09;&#x8868;&#x793a;&#xff0c;&#x5230;&#x4e86;2026&#x5e74;8&#x67