/fosstodon.org/@ratatui_rs","acct":"ratatui_rs@fosstodon.org"}],"tags":[{"name":"rustlang","url":"https://mastodon.social/tags/rustlang"},{"name":"ratatui","url":"https://mastodon.social/tags/ratatui"},{"name":"tui","url":"https://mastodon.social/tags/tui"},{"name":"terminal","url":"https://mastodon.social/tags/terminal"},{"name":"voicechat","url":"https://mastodon.social/tags/voicechat"},{"name":"p2p","url":"https://mastodon.social/tags/p2p"}],"emojis":[],"tagged_collections":[],"quote":null,"card":null,"poll":null,"quote_approval":{"automatic":["public"],"manual":[],"current_user":"denied"}},{"id":"117345052887859316","created_at":"2026-09-27T21:10:08.000Z","in_reply_to_id":null,"in_reply_to_account_id":null,"sensitive":false,"spoiler_text":"","visibility":"public","language":"en","uri":"https://hachyderm.io/users/ekuber/statuses/117345052829374264","url":"https://hachyderm.io/@ekuber/117345052829374264","replies_count":0,"reblogs_count":8,"favourites_count":1,"quotes_count":0,"edited_at":null,"content":"<p><a href=\"https://tako8ki.com/posts/looking-for-a-new-role/\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://</span><span class=\"ellipsis\">tako8ki.com/posts/looking-for-</span><span class=\"invisible\">a-new-role/</span></a><br><a href=\"https://hachyderm.io/tags/Rust\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>Rust</span></a> <a href=\"https://hachyderm.io/tags/Rustlang\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>Rustlang</span></a> <a href=\"https://hachyderm.io/tags/FediHire\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>FediHire</span></a></p>","reblog":null,"account":{"id":"109317278682838845","username":"ekuber","acct":"ekuber@hachyderm.io","display_name":"Esteban Küber :rust:","locked":false,"bot":false,"discoverable":true,"indexable":true,"group":false,"created_at":"2022-11-10T00:00:00.000Z","note":"<p>\"We spent decades trying to invent a sufficiently smart compiler when we should have been inventing a sufficiently empathetic one.\" — @benleedom</p><p><a href=\"https://hachyderm.io/tags/Rust\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>Rust</span></a> Compiler team member. If you have to search for answers when the compiler is talking to you, that's a bug.</p><p>There are no bad programmers, only insufficiently advanced compilers.</p><p>Cache-locality awareness evangelist. UTF-8 maximalist.</p><p>You can't \"individual responsibility\" your way out of systemic problems.</p><p>he/him</p><p>Trans rights are human rights</p>","url":"https://hachyderm.io/@ekuber","uri":"https://hachyderm.io/users/ekuber","avatar":"https://files.mastodon.social/cache/accounts/avatars/109/317/278/682/838/845/original/67fa540f17338581.jpg","avatar_static":"https://files.mastodon.social/cache/accounts/avatars/109/317/278/682/838/845/original/67fa540f17338581.jpg","avatar_description":"","header":"https://files.mastodon.social/cache/accounts/headers/109/317/278/682/838/845/original/a1d8631027e15704.jpg","header_static":"https://files.mastodon.social/cache/accounts/headers/109/317/278/682/838/845/original/a1d8631027e15704.jpg","header_description":"","followers_count":4880,"following_count":1732,"statuses_count":4801,"last_status_at":"2026-09-27","hide_collections":false,"show_media":true,"show_media_replies":true,"show_featured":true,"feature_approval":{"automatic":["public"],"manual":[],"current_user":"denied"},"emojis":[{"shortcode":"rust","url":"https://files.mastodon.social/cache/custom_emojis/images/000/441/977/original/a35b51b421b9cf59.png","static_url":"https://files.mastodon.social/cache/custom_emojis/images/000/441/977/static/a35b51b421b9cf59.png","visible_in_picker":true}],"fields":[{"name":"GitHub","value":"<a href=\"https://github.com/estebank\" target=\"_blank\" rel=\"nofollow noopener\" translate=\"no\"><span class=\"invisible\">https://</span><span class=\"\">github.com/estebank</span><span class=\"invisible\"></span></a>","verified_at":"2026-09-27T20:06:50.956+00:00"}]},"media_attachments":[],"mentions":[],"tags":[{"name":"rust","url":"https://mastodon.social/tags/rust"},{"name":"rustlang","url":"https://mastodon.social/tags/rustlang"},{"name":"FediHire","url":"https://mastodon.social/tags/FediHire"}],"emojis":[],"tagged_collections":[],"quote":null,"card":{"url":"https://tako8ki.com/posts/looking-for-a-new-role/","title":"I'm a Rust compiler maintainer looking for a new role","description":"I am Takayuki Maeda (X: TaKOBKi, GitHub: TaKO8Ki), a Rust compiler maintainer and a Staff Software Engineer based in Kyoto, Japan. I am looking for a role where …","language":"en","type":"link","author_name":"","author_url":"","provider_name":"","provider_url":"","html":"","width":662,"height":348,"image":"https://files.mastodon.social/cache/preview_cards/images/202/436/071/original/51cc21f913dbfb0a.png","image_description":"I'm a Rust compiler maintainer looking for a new role","embed_url":"","blurhash":"UHR3Zi=#9r~D~D0d^,Inx[^+Inof~ps.IUn*","published_at":null,"authors":[]},"poll":null,"quote_approval":{"automatic":["public"],"manual":[],"current_user":"denied"}},{"id":"117344925949246159","created_at":"2026-09-27T20:37:48.000Z","in_reply_to_id":null,"in_reply_to_account_id":null,"sensitive":false,"spoiler_text":"","visibility":"public","language":"en","uri":"https://oldbytes.space/users/haitchfive/statuses/117344925701533802","url":"https://oldbytes.space/@haitchfive/117344925701533802","replies_count":0,"reblogs_count":2,"favourites_count":4,"quotes_count":0,"edited_at":null,"content":"<p>One little known paradox is that systems programmers who develop programming languages in the early years of their project spend all of the time reading and writing code in the host language their language is written in.  </p><p>That balance eventually changes once work shifts to improving the standard library and later after self-hosting is achieved. But that process can take years.</p><p>The pace of mechanography has accelerated, but the human brain still can't be overclocked. Genuinely difficult design problems are still capped at human brain speed.</p><p><a href=\"https://oldbytes.space/tags/golang\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>golang</span></a> <a href=\"https://oldbytes.space/tags/rustlang\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>rustlang</span></a> <a href=\"https://oldbytes.space/tags/compsci\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>compsci</span></a> <a href=\"https://oldbytes.space/tags/programming\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>programming</span></a> <a href=\"https://oldbytes.space/tags/clang\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>clang</span></a></p>","reblog":null,"account":{"id":"110964853032828807","username":"haitchfive","acct":"haitchfive@oldbytes.space","display_name":"@haitchfive","locked":false,"bot":false,"discoverable":true,"indexable":false,"group":false,"created_at":"2023-08-27T00:00:00.000Z","note":"<p>I move bits around so that, in turn, they move some other bits around themselves. <br><a href=\"https://oldbytes.space/tags/DeluxeDraw\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>DeluxeDraw</span></a> <a href=\"https://oldbytes.space/tags/ual\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>ual</span></a> <a href=\"https://oldbytes.space/tags/zen80\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>zen80</span></a> <a href=\"https://oldbytes.space/tags/zenzx\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>zenzx</span></a> <a href=\"https://oldbytes.space/tags/TOSID\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>TOSID</span></a> <a href=\"https://oldbytes.space/tags/KMAC\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>KMAC</span></a> <a href=\"https://oldbytes.space/tags/DXP\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>DXP</span></a> <a href=\"https://oldbytes.space/tags/XTXT\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>XTXT</span></a> <a href=\"https://oldbytes.space/tags/ZXSpectrum\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>ZXSpectrum</span></a>, <a href=\"https://oldbytes.space/tags/Speccy\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>Speccy</span></a>, <a href=\"https://oldbytes.space/tags/SpectrumNext\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>SpectrumNext</span></a>, <a href=\"https://oldbytes.space/tags/Spectrum256\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>Spectrum256</span></a>, <a href=\"https://oldbytes.space/tags/Z80\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>Z80</span></a>, <a href=\"https://oldbytes.space/tags/ZXGUI\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>ZXGUI</span></a>, <a href=\"https://oldbytes.space/tags/SMPeccy\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>SMPeccy</span></a> <a href=\"https://oldbytes.space/tags/retrocomputing\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>retrocomputing</span></a>, <a href=\"https://oldbytes.space/tags/neoretro\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>neoretro</span></a> <a href=\"https://oldbytes.space/tags/golang\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>golang</span></a> <a href=\"https://oldbytes.space/tags/ZXSpectrum256\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>ZXSpectrum256</span></a></p>","url":"https://oldbytes.space/@haitchfive","uri":"https://oldbytes.space/users/haitchfive","avatar":"https://files.mastodon.social/cache/accounts/avatars/110/964/853/032/828/807/original/13bf6a1d4b0ef584.png","avatar_static":"https://files.mastodon.social/cache/accounts/avatars/110/964/853/032/828/807/original/13bf6a1d4b0ef584.png","avatar_description":"","header":"https://files.mastodon.social/cache/accounts/headers/110/964/853/032/828/807/original/525a2da680e23502.jpg","header_static":"https://files.mastodon.social/cache/accounts/headers/110/964/853/032/828/807/original/525a2da680e23502.jpg","header_description":"","followers_count":586,"following_count":394,"statuses_count":8710,"last_status_at":"2026-09-27","hide_collections":false,"show_media":true,"show_media_replies":true,"show_featured":true,"feature_approval":{"automatic":["public"],"manual":[],"current_user":"denied"},"emojis":[],"fields":[{"name":"The ual programming language","value":"<a href=\"https://github.com/ha1tch/ual#readme\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://</span><span class=\"\">github.com/ha1tch/ual#readme</span><span class=\"invisible\"></span></a>","verified_at":null},{"name":"gitstuff","value":"<a href=\"https://github.com/ha1tch\" target=\"_blank\" rel=\"nofollow noopener\" translate=\"no\"><span class=\"invisible\">https://</span><span class=\"\">github.com/ha1tch</span><span class=\"invisible\"></span></a>","verified_at":"2026-09-27T05:21:34.324+00:00"},{"name":"tosid / kmac / dxp / compsci","value":"tosid@ual.li","verified_at":null},{"name":"ZX Spectrum Project: emulator, sprite editor, assembler, and more.","value":"<a href=\"https://ha1tch.github.io/zsp/\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://</span><span class=\"\">ha1tch.github.io/zsp/</span><span class=\"invisible\"></span></a>","verified_at":null}]},"media_attachments":[],"mentions":[],"tags":[{"name":"golang","url":"https://mastodon.social/tags/golang"},{"name":"rustlang","url":"https://mastodon.social/tags/rustlang"},{"name":"compsci","url":"https://mastodon.social/tags/compsci"},{"name":"programming","url":"https://mastodon.social/tags/programming"},{"name":"clang","url":"https://mastodon.social/tags/clang"}],"emojis":[],"tagged_collections":[],"quote":null,"card":null,"poll":null,"quote_approval":{"automatic":["public"],"manual":[],"current_user":"denied"}},{"id":"117344907120027416","created_at":"2026-09-27T20:33:05.000Z","in_reply_to_id":null,"in_reply_to_account_id":null,"sensitive":false,"spoiler_text":"","visibility":"public","language":"de","uri":"https://social.tchncs.de/users/cehteh/statuses/117344907101086561","url":"https://social.tchncs.de/@cehteh/117344907101086561","replies_count":0,"reblogs_count":0,"favourites_count":0,"quotes_count":0,"edited_at":null,"content":"<p>Specialization is a often asked but highly unstable feature. There exists dtolnays autoref trick and some improvements over that. I wasn't satisfied with that because it needs a pretty ugly syntax (basically only useable from macros). And it can't mix method that take parameters by value, as immutable reference or as mutable reference.</p><p><a href=\"https://crates.io/crates/autoref-special\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://</span><span class=\"ellipsis\">crates.io/crates/autoref-speci</span><span class=\"invisible\">al</span></a></p><p>This is highly experimental (v0.0.0) and i forgotten to add the repo link to Cargo.toml: <a href=\"https://seed.pipapo.org/nodes/iris.radicle.network/rad:z2WhBAFute9kaa4S9df4DXnWUFQHG\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://</span><span class=\"ellipsis\">seed.pipapo.org/nodes/iris.rad</span><span class=\"invisible\">icle.network/rad:z2WhBAFute9kaa4S9df4DXnWUFQHG</span></a></p><p>Freel free to discuss this here or as radicle issues (or on IRC).</p><p><a href=\"https://social.tchncs.de/tags/rustlang\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>rustlang</span></a></p>","reblog":null,"account":{"id":"114211640861293009","username":"cehteh","acct":"cehteh@social.tchncs.de","display_name":"cehteh","locked":false,"bot":false,"discoverable":true,"indexable":true,"group":false,"created_at":"2025-02-25T00:00:00.000Z","note":"<p><a href=\"https://social.tchncs.de/tags/cycling\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>cycling</span></a> <a href=\"https://social.tchncs.de/tags/programming\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>programming</span></a> <a href=\"https://social.tchncs.de/tags/rustlang\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>rustlang</span></a> <a href=\"https://social.tchncs.de/tags/linux\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>linux</span></a></p>","url":"https://social.tchncs.de/@cehteh","uri":"https://social.tchncs.de/users/cehteh","avatar":"https://files.mastodon.social/cache/accounts/avatars/114/211/640/861/293/009/original/e844200af214d484.png","avatar_static":"https://files.mastodon.social/cache/accounts/avatars/114/211/640/861/293/009/original/e844200af214d484.png","avatar_description":"","header":"https://mastodon.social/headers/original/missing.png","header_static":"https://mastodon.social/headers/original/missing.png","header_description":"","followers_count":45,"following_count":11,"statuses_count":320,"last_status_at":"2026-09-27","hide_collections":false,"show_media":true,"show_media_replies":true,"show_featured":true,"feature_approval":{"automatic":["public"],"manual":[],"current_user":"denied"},"emojis":[],"fields":[{"name":"pixelfed","value":"<a href=\"https://photocave.net/@cehteh\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://</span><span class=\"\">photocave.net/@cehteh</span><span class=\"invisible\"></span></a>","verified_at":null},{"name":"DeltaChat","value":"<a href=\"https://i.delta.chat/#7397EA62ACBEB642BADDAD09F7FCCE8A7190EC76&amp;a=7r2id00gq%40nine.testrun.org&amp;n=cehteh&amp;i=JXDnfAUDaiBlVAKWxrpKJNq8&amp;s=kGVUZOl6pUlp-DLgZNSU5Jhe\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://</span><span class=\"ellipsis\">i.delta.chat/#7397EA62ACBEB642</span><span class=\"invisible\">BADDAD09F7FCCE8A7190EC76&amp;a=7r2id00gq%40nine.testrun.org&amp;n=cehteh&amp;i=JXDnfAUDaiBlVAKWxrpKJNq8&amp;s=kGVUZOl6pUlp-DLgZNSU5Jhe</span></a>","verified_at":null},{"name":"radicle","value":"<a href=\"https://seed.pipapo.org/nodes/seed.pipapo.org/users/z6MksaJkZuQj49mbrft8JNvo3vBDU5AC5owW1EnCZJJ3goRX\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://</span><span class=\"ellipsis\">seed.pipapo.org/nodes/seed.pip</span><span class=\"invisible\">apo.org/users/z6MksaJkZuQj49mbrft8JNvo3vBDU5AC5owW1EnCZJJ3goRX</span></a>","verified_at":null}]},"media_attachments":[],"mentions":[],"tags":[{"name":"rustlang","url":"https://mastodon.social/tags/rustlang"}],"emojis":[],"tagged_collections":[],"quote":null,"card":{"url":"https://crates.io/crates/autoref-special","title":"crates.io: Rust Package Registry","description":"crates.io serves as a central registry for sharing crates, which are packages or libraries written in Rust that you can use to enhance your projects","language":"en","type":"link","author_name":"","author_url":"","provider_name":"","provider_url":"","html":"","width":662,"height":348,"image":"https://files.mastodon.social/cache/preview_cards/images/208/750/435/original/15e18ae1097cc670.png","image_description":"","embed_url":"","blurhash":"UgOp-]ayayxu01WBoLj@01t6oLR%IUxaayWB","published_at":null,"authors":[]},"poll":null,"quote_approval":{"automatic":["public"],"manual":[],"current_user":"denied"}},{"id":"117344364592967259","created_at":"2026-09-27T18:15:04.000Z","in_reply_to_id":null,"in_reply_to_account_id":null,"sensitive":false,"spoiler_text":"","visibility":"public","language":"en","uri":"https://techhub.social/users/infoq/statuses/117344364440726558","url":"https://techhub.social/@infoq/117344364440726558","replies_count":0,"reblogs_count":0,"favourites_count":1,"quotes_count":1,"edited_at":null,"content":"<p><a href=\"https://techhub.social/tags/Cloudflare\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>Cloudflare</span></a> just redesigned the in-memory representation of its Big Pineapple DNS cache, dropping memory footprint by 56% per entry &amp; freeing ~100 TB fleetwide.</p><p>Key highlights: <br>➤ 43% higher cache insertion throughput <br>➤ 19% lower lookup latency <br>➤ More cache capacity without more memory</p><p>🔗 Full write-up on <a href=\"https://techhub.social/tags/InfoQ\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>InfoQ</span></a> - <a href=\"https://www.infoq.com/news/2026/09/cloudflare-dns-cache/\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://www.</span><span class=\"ellipsis\">infoq.com/news/2026/09/cloudfl</span><span class=\"invisible\">are-dns-cache/</span></a></p><p><a href=\"https://techhub.social/tags/RustLang\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>RustLang</span></a> <a href=\"https://techhub.social/tags/SoftwareArchitecture\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>SoftwareArchitecture</span></a> <a href=\"https://techhub.social/tags/DistributedSystems\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>DistributedSystems</span></a> <a href=\"https://techhub.social/tags/Performance\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>Performance</span></a> <a href=\"https://techhub.social/tags/DNS\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>DNS</span></a></p>","reblog":null,"account":{"id":"109428347707042517","username":"infoq","acct":"infoq@techhub.social","display_name":"InfoQ","locked":false,"bot":false,"discoverable":true,"indexable":false,"group":false,"created_at":"2022-11-24T00:00:00.000Z","note":"<p>Helping dev teams adopt new technologies and practices for 16 years. Written by software engineers. Read by over 1.5 m devs worldwide.</p><p><a href=\"https://linktr.ee/infoq\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://</span><span class=\"\">linktr.ee/infoq</span><span class=\"invisible\"></span></a></p>","url":"https://techhub.social/@infoq","uri":"https://techhub.social/users/infoq","avatar":"https://files.mastodon.social/cache/accounts/avatars/109/428/347/707/042/517/original/de8e9621a3bfd3c0.png","avatar_static":"https://files.mastodon.social/cache/accounts/avatars/109/428/347/707/042/517/original/de8e9621a3bfd3c0.png","avatar_description":"","header":"https://files.mastodon.social/cache/accounts/headers/109/428/347/707/042/517/original/8f7b60e1c3b55e53.png","header_static":"https://files.mastodon.social/cache/accounts/headers/109/428/347/707/042/517/original/8f7b60e1c3b55e53.png","header_description":"","followers_count":1093,"following_count":233,"statuses_count":2476,"last_status_at":"2026-09-27","hide_collections":false,"show_media":true,"show_media_replies":true,"show_featured":true,"feature_approval":{"automatic":["public"],"manual":[],"current_user":"denied"},"emojis":[],"fields":[{"name":"InfoQ","value":"<a href=\"https://www.infoq.com/\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://www.</span><span class=\"\">infoq.com/</span><span class=\"invisible\"></span></a>","verified_at":null},{"name":"QCon","value":"<a href=\"https://qconferences.com/\" rel=\"nofol