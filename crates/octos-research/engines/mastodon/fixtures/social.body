[{"id":"117345327247593213","created_at":"2026-09-27T22:19:53.000Z","in_reply_to_id":null,"in_reply_to_account_id":null,"sensitive":false,"spoiler_text":"","visibility":"public","language":"en","uri":"https://fosstodon.org/users/orhun/statuses/117345327084337960","url":"https://fosstodon.org/@orhun/117345327084337960","replies_count":0,"reblogs_count":1,"favourites_count":1,"quotes_count":0,"edited_at":null,"content":"<p>Voice chat in the terminal!? 🤯</p><p>🥫 **tincan** — Serverless P2P voice &amp; text chat for your terminal</p><p>🔥 No accounts, no port forwarding &amp; no server hosting</p><p>💯 Just share an invite and start talking!</p><p>🦀 Written in Rust &amp; built with <span class=\"h-card\" translate=\"no\"><a href=\"https://fosstodon.org/@ratatui_rs\" class=\"u-url mention\" rel=\"nofollow noopener\" target=\"_blank\">@<span>ratatui_rs</span></a></span></p><p>⭐ GitHub: <a href=\"https://github.com/bilalyazicioglu/tincan-cli\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://</span><span class=\"ellipsis\">github.com/bilalyazicioglu/tin</span><span class=\"invisible\">can-cli</span></a></p><p><a href=\"https://fosstodon.org/tags/rustlang\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>rustlang</span></a> <a href=\"https://fosstodon.org/tags/ratatui\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>ratatui</span></a> <a href=\"https://fosstodon.org/tags/tui\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>tui</span></a> <a href=\"https://fosstodon.org/tags/terminal\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>terminal</span></a> <a href=\"https://fosstodon.org/tags/voicechat\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>voicechat</span></a> <a href=\"https://fosstodon.org/tags/p2p\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>p2p</span></a></p>","reblog":null,"account":{"id":"109502224333340260","username":"orhun","acct":"orhun@fosstodon.org","display_name":"Orhun Parmaksız 👾","locked":false,"bot":false,"discoverable":true,"indexable":false,"group":false,"created_at":"2022-12-12T00:00:00.000Z","note":"<p>Terminal Chef 🐀</p><p><span class=\"h-card\" translate=\"no\"><a href=\"https://fosstodon.org/@ratatui_rs\" class=\"u-url mention\" rel=\"nofollow noopener\" target=\"_blank\">@<span>ratatui_rs</span></a></span> · @jetbrains · <span class=\"h-card\" translate=\"no\"><a href=\"https://fosstodon.org/@archlinux\" class=\"u-url mention\" rel=\"nofollow noopener\" target=\"_blank\">@<span>archlinux</span></a></span></p><p>Open source: <a href=\"https://github.com/orhun\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://</span><span class=\"\">github.com/orhun</span><span class=\"invisible\"></span></a><br>Livestreams: <a href=\"https://youtube.com/@orhundev\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://</span><span class=\"\">youtube.com/@orhundev</span><span class=\"invisible\"></span></a></p>","url":"https://fosstodon.org/@orhun","uri":"https://fosstodon.org/users/orhun","avatar":"https://files.mastodon.social/cache/accounts/avatars/109/502/224/333/340/260/original/21c41ce0d371d3ed.jpg","avatar_static":"https://files.mastodon.social/cache/accounts/avatars/109/502/224/333/340/260/original/21c41ce0d371d3ed.jpg","avatar_description":"","header":"https://files.mastodon.social/cache/accounts/headers/109/502/224/333/340/260/original/3b12e979e21a611f.jpeg","header_static":"https://files.mastodon.social/cache/accounts/headers/109/502/224/333/340/260/original/3b12e979e21a611f.jpeg","header_description":"","followers_count":2094,"following_count":363,"statuses_count":3097,"last_status_at":"2026-09-27","hide_collections":false,"show_media":true,"show_media_replies":true,"show_featured":true,"feature_approva