// MediaWiki Action API, list=search, on <lang>.wikipedia.org.
// Written from https://www.mediawiki.org/wiki/API:Search
// In general search it adds encyclopedia context next to web results, so
// it asks for at most 4 articles.
use mod.markup
use mod.net
use mod.std.array
use mod.std.math
use mod.std.object
use mod.std.text

fn host(opts) {
    let p = if opts.lang == nil {
        "en"
    } else {
        opts.lang.primary
    }
    return p + ".wikipedia.org"
}

fn build_request(query, opts) {
    let params = [["action", "query"], ["list", "search"], ["srsearch", query], ["srlimit", math.min(opts.count, 4)], ["sroffset", (opts.page - 1) * opts.count], ["srprop", "snippet"], ["format", "json"], ["formatversion", "2"]]
    let u = net.url({base: "https://" + host(opts) + "/w/api.php", query: params})
    return net.request({url: u.url, headers: {accept: "application/json"}})
}

// Article URL from its title: spaces become underscores; characters that
// would end the path are escaped.
fn article_url(h, title) {
    let t = text.replace_all(title, "%", "%25")
    t = text.replace_all(t, "?", "%3F")
    t = text.replace_all(t, "#", "%23")
    t = text.replace_all(t, " ", "_")
    return "https://" + h + "/wiki/" + t
}

fn parse_response(response, opts) {
    let data = response.json
    let q = object.get(data, "query", {})
    let h = host(opts)
    let out = []
    for r in object.get(q, "search", []) {
        let title = object.get(r, "title", "")
        if title == "" {
            continue
        }
        array.push(out, {
            url: article_url(h, title),
            title: title,
            snippet: markup.text({html: object.get(r, "snippet", "")}).text,
            source: "Wikipedia",
            lang: text.slice(h, 0, text.index_of(h, "."))
        })
    }
    return out
}
