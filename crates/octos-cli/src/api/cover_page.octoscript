use mod.tool
use mod.std.assert

let opened = tool.start("page.make", "assigned").await()
assert(opened == "published")
loop {
    let verdict = tool.start("page.review", "current_candidate").await()
    if verdict == "approved" {
        break
    }
    if verdict == "manual" {
        let decision = tool.start("page.arbitrate", "current_verdict").await()
        if decision == "dispute" {
            continue
        }
        assert(decision == "confirm")
    } else {
        assert(verdict == "native")
    }
    let revised = tool.start("page.repair", "current_verdict").await()
    assert(revised == "published")
}
